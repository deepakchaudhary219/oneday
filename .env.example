# Copy to .env for `docker compose up`. Use long random values, e.g. `openssl rand -base64 48`.
# .env is git-ignored; never commit real secrets.
MYSQL_PASSWORD=
REDIS_PASSWORD=
ONEDAY_JWT_SECRET=
ONEDAY_LOCATION_SECRET=
MEDIA_ACCESS_KEY=
MEDIA_SECRET_KEY=
# Optional: user ids (not emails) to treat as ADMIN, to bootstrap the first staff member.
ONEDAY_BOOTSTRAP_ADMIN_IDS=
